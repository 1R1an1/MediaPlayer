#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# Copyright (c) 2026 1R1an1
#
# Install MediaPlayer from the git repo.

set -e

REPO_URL="https://github.com/1R1an1/MediaPlayer.git"
APP_NAME="mediaplayer"
BIN_NAME="mp"
INSTALL_DIR="/opt/$APP_NAME"
BIN_LINK="/usr/local/bin/$BIN_NAME"
DESKTOP_FILE="/usr/share/applications/$APP_NAME.desktop"
ICON_DIR="/usr/share/icons/hicolor/scalable/apps"

# Dependencias: git, dotnet, ffmpeg (incluye ffprobe), libmpv2.
DEPS="git dotnet ffmpeg ffprobe"

err() { echo -e "\033[31m[ERROR]\033[0m $*" >&2; exit 1; }
info() { echo -e "\033[36m[INFO]\033[0m $*"; }

# Verificar que tenemos sudo
[[ $EUID -ne 0 ]] && SUDO="sudo" || SUDO=""

# Verificar dependencias
info "Checking system dependencies..."
miss=0

set +e
for dep in $DEPS; do
    command -v "$dep" >/dev/null 2>&1 || ((miss++))
done
$SUDO ldconfig -p 2>/dev/null | grep -q "libmpv.so.2" || ((miss++))
set -e

if [[ $miss -gt 0 ]]; then
    if   command -v apt    >/dev/null 2>&1; then cmd="$SUDO apt install"; dn="dotnet-sdk-10.0"; mpv="libmpv2"
    elif command -v pacman >/dev/null 2>&1; then cmd="$SUDO pacman -S --needed"; dn="dotnet-sdk"; mpv="mpv"
    elif command -v dnf    >/dev/null 2>&1; then cmd="$SUDO dnf install"; dn="dotnet-sdk-10.0"; mpv="mpv-libs"
    else err "$miss package(s) are missing and no package manager was detected."; fi
    read -rp "$miss package(s) are missing. Install? [y/N]" yn
    [[ "$yn" =~ ^[Yy]$ ]] || err "Canceled."
    $cmd git $dn ffmpeg $mpv || err "Installation failed."
fi

# Verificar versión de .NET SDK
info "Checking .NET SDK..."
DOTNET_VERSION=$(dotnet --version 2>/dev/null || echo "0")
[[ "$DOTNET_VERSION" =~ ^10 ]] || err "Requires .NET SDK 10.0+. You have: $DOTNET_VERSION"

# Crear dir temporal
TMP_DIR=$(mktemp -d /tmp/$APP_NAME-setup.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
info "Cloning repo in $TMP_DIR..."

# Clonar con submódulos
git clone --recursive "$REPO_URL" "$TMP_DIR/$APP_NAME"
cd "$TMP_DIR/$APP_NAME"

# Publicar
info "Compiling..."
dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true
PUBLISH_DIR="$TMP_DIR/$APP_NAME/bin/Release/net10.0/linux-x64/publish"

[[ -f "$PUBLISH_DIR/MediaPlayer" ]] || err "The compiled binary was not found in $PUBLISH_DIR"

# Instalar
info "Installing in $INSTALL_DIR..."
$SUDO rm -rf "$INSTALL_DIR"
$SUDO mkdir -p "$INSTALL_DIR"
$SUDO cp -r "$PUBLISH_DIR"/* "$INSTALL_DIR/"
$SUDO chmod +x "$INSTALL_DIR/MediaPlayer"

# Symlink del comando
info "Creating symlink $BIN_LINK → $INSTALL_DIR/MediaPlayer..."
$SUDO ln -sf "$INSTALL_DIR/MediaPlayer" "$BIN_LINK"

# yt.sh
info "Installing yt.sh..."
$SUDO cp -f yt.sh "$INSTALL_DIR/yt.sh"
$SUDO chmod +x "$INSTALL_DIR/yt.sh"
$SUDO ln -sf "$INSTALL_DIR/yt.sh" "/usr/local/bin/yt.sh"

# Ícono
info "Installing icon..."
$SUDO mkdir -p "$ICON_DIR"
$SUDO cp -f Svgs/Icon.svg "$ICON_DIR/$APP_NAME.svg"

# .desktop
info "Creating $DESKTOP_FILE..."
$SUDO tee "$DESKTOP_FILE" >/dev/null <<EOF
[Desktop Entry]
Name=Media Player
Comment=MPV-based video player
Comment[es]=Reproductor de video basado en mpv
Exec=$BIN_LINK %U
Icon=$APP_NAME
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-flv;video/x-ms-wmv;video/mpeg;audio/mpeg;audio/flac;
EOF

# Actualizar caches de desktop
$SUDO update-desktop-database /usr/share/applications 2>/dev/null || true
$SUDO gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

info "Ready."
info ""
info "Installed successfully. Use it with the \`mp\` command or from the applications menu."
info "yt.sh is also installed. Use it with the \`yt.sh\` command, the usage is in the README."
info "If it doesn't appear in the menu, restart your session."

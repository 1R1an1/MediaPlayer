<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:MediaPlayer.Models"
             xmlns:l="using:MediaPlayer"
             x:Class="MediaPlayer.Views.PlaylistView"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="2,10,2,2" RowDefinitions="*,Auto">

        <!-- Lista con ItemTemplate -->
        <Border Grid.Row="0" Margin="0" Padding="0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.03"/>
                    <GradientStop Color="Black" Offset="0.97"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <ListBox x:Name="List" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                     Padding="5" ItemsSource="{Binding Items, Source={x:Static l:App.Playlist}, Mode=OneWay}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <ContentPresenter CornerRadius="5" Margin="4,2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <!-- Botón oculto por defecto -->
                    <Style Selector="ListBoxItem Button /template/ ContentPresenter">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>

                    <!-- Botón visible al pasar el mouse -->
                    <Style Selector="ListBoxItem:pointerover Button /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                    <!-- Hover del botón: se enciende -->
                    <Style Selector="ListBoxItem:pointerover Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2f55"/>
                        <Setter Property="Foreground" Value="#faa"/>
                    </Style>

                    <!-- Pressed: más fuerte -->
                    <Style Selector="ListBoxItem:pointerover Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#4f55"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="m:PlaylistItem">
                        <Border Background="{Binding IsCurrent, Converter={StaticResource IsCurrentConverter}}" CornerRadius="5">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Background="Transparent" Spacing="8" Margin="7" ClipToBounds="True">
                                    <!-- Cover -->
                                    <Border Height="45" ClipToBounds="True" CornerRadius="5">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Source="{Binding CoverMap}" />
                                            <Border Padding="5,2" Background="#a000" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,2">
                                                <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="#ddd"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Textos -->
                                    <StackPanel Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#aaa" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Classes="texticon bold" Margin="0,0,10,0"
                                        x:Name="RemoveBtn" Tag="{Binding}" Click="RemoveBtn_Click"
                                        Content="✕" FontSize="16" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer: título + 2 icons alineados a la derecha -->
        <Grid Grid.Row="1" ColumnDefinitions="*,5,Auto" Margin="14,3,8,2">
            <TextBlock Grid.Column="0" Text="Cola de reproducción"
                       FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ClearBtn" Classes="texticon" ToolTip.Tip="Limpiar cola" Padding="0">
                    <Path Data="M28.987 6.247c-.027-.292-.113-.521-.233-.785-.086-.189-.307-.333-.498-.385a.8.8 0 0 0-.209-.028.8.8 0 0 0 .101-.368.84.84 0 0 0-.245-.589c-.167-.167-.358-.22-.587-.243a10 10 0 0 0-1.037-.045c-.436 0-.873.016-1.307.018q-1.242.007-2.483.058c-1.711.07-3.422.134-5.13.183a334 334 0 0 1-5.105.099c-1.736.023-3.472-.006-5.206.07-.424.018-.846.057-1.266.109-.342.045-.677.091-1.005.2-.222.073-.44.17-.646.275-.332.167-.575.425-.783.727-.216.311-.311.688-.344 1.06-.027.307.105.61.227.883.053.114.134.222.204.329q.175.272.34.548a.87.87 0 0 0 .861.413l.007.001c.212-.001.423-.006.635-.007q.033.836.133 1.67c.101.809.179 1.617.268 2.426.177 1.633.465 3.25.743 4.868.272 1.571.562 3.14.838 4.709.14.797.264 1.594.416 2.387.138.739.309 1.47.453 2.207q.043.225.084.453c.078.418.579.651.962.546.041-.011.071-.038.108-.055a.9.9 0 0 0 .419.135c1.814.058 3.624.066 5.438.054.737-.004 1.476.004 2.212.012.945.01 1.89.02 2.835.004.636-.012 1.273.006 1.907-.039a.9.9 0 0 0 .42-.139c.014.005.023.015.037.019.408.113.935-.134 1.019-.579.157-.828.358-1.647.533-2.471q.269-1.261.494-2.527c.317-1.787.548-3.587.844-5.375.262-1.579.484-3.163.694-4.75l-.029.222q.17-1.23.331-2.462c.081-.588.18-1.173.279-1.759.249-.021.499-.036.747-.07.218-.031.412-.12.612-.206.297-.128.554-.377.71-.657.14-.253.187-.537.212-.82a2 2 0 0 0-.01-.326m-9.635 12.826-.369-.369a80 80 0 0 1-1.577-1.61c-.168-.177-.345-.344-.519-.514.672-.71 1.341-1.421 2.016-2.127.228-.239.468-.466.699-.702l.121.118c.56.533 1.118 1.063 1.654 1.62.234.243.476.475.714.713l-.2.202c-.54.546-1.06 1.114-1.59 1.668zm-9.981-7.399q.865.786 1.722 1.581l.189.172c-.391.419-.778.841-1.195 1.233-.421.396-.857.775-1.287 1.162-.298-.315-.593-.632-.895-.943a.74.74 0 0 0-.46-.21c-.054-.346-.118-.69-.169-1.036-.031-.248-.055-.498-.082-.747a33 33 0 0 1 1.724-1.637c.153.14.3.285.453.425m6.915-1.199c.569.595 1.15 1.171 1.745 1.738q.28.27.557.546c-.247.253-.497.504-.741.761l-1.983 2.097-.176-.161c-.762-.69-1.515-1.39-2.27-2.086.35-.342.7-.682 1.0
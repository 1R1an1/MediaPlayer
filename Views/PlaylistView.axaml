                          Fill="{StaticResource AccentBrush}" Width="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>

                <Button x:Name="CloseBtn" Classes="texticon bold" Content="✕" FontSize="18"
                        ToolTip.Tip="Cerrar (C)"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

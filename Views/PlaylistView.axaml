<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:MediaPlayer.Models"
             xmlns:l="using:MediaPlayer"
             x:Class="MediaPlayer.Views.PlaylistView"
             Background="{StaticResource BackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="16,14"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Cola de reproducción"
                           FontSize="{StaticResource FontSizeMedium}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" />
                <Button Grid.Column="1"
                        x:Name="CloseBtn"
                        Classes="icon"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="28" Height="28"
                        CornerRadius="14"
                        FontFamily="{StaticResource MonoFontFamily}"
                        Content="X"
                        ToolTip.Tip="Cerrar (C)"/>
            </Grid>
        </Border>

        <!-- Lista con ItemTemplate -->
        <ListBox Grid.Row="1" x:Name="List" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                 Padding="10" ItemsSource="{Binding Items, Source={x:Static l:App.Playlist}, Mode=OneWay}">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <ContentPresenter CornerRadius="5" Margin="4,2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="m:PlaylistItem">
                    <Border Background="{Binding IsCurrent, Converter={StaticResource IsCurrentConverter}}" CornerRadius="5">
                        <StackPanel Orientation="Horizontal"  Background="Transparent" Spacing="8" Margin="7" ClipToBounds="True">
                            <!-- Cover -->
                            <Border Width="71" Height="40" ClipToBounds="True" CornerRadius="5">
                                <Image Stretch="UniformToFill" Source="{Binding CoverMap}" />
                            </Border>

                            <!-- Textos -->
                            <StackPanel Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button x:Name="ClearBtn"
                    Content="Limpiar cola"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="8,6" />
        </Border>

    </Grid>
</UserControl>

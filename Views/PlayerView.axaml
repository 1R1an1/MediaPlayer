<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MediaPlayer.Views"
             x:Class="MediaPlayer.Views.PlayerView">

    <Grid x:Name="RootGrid" Margin="2,0,0,0" Background="{StaticResource BackgroundBrush}">

        <!-- Video: renderiza via OpenGL a una textura Avalonia -->
        <v:MpvGlControl Margin="-2,0,0,0" IsVisible="False" x:Name="VideoHost" />

        <!-- Popup del slider de volumen. Va AFUERA del overlay para que no
        lo recorten los contenedores chicos. -->
        <Grid x:Name="VolumePopup"
              Margin="0,0,89,30"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              IsVisible="False"
              Height="150"
              Background="Transparent"
              IsHitTestVisible="True">
            <Border
                Background="{StaticResource IslandBrush}"
                CornerRadius="{StaticResource PopupCornerRadius}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="{StaticResource AllBorderThickness}"
                VerticalAlignment="Top"
                Height="120"
                Padding="5,12"
                BoxShadow="{StaticResource ControlShadow}">
                <Slider x:Name="VolumeSlider"
                        Orientation="Vertical"
                        Height="100"
                        Minimum="0"
                        Maximum="1"
                        Width="20" />
            </Border>
        </Grid>

        <!-- Overlay que contiene las islas. Se oculta con Opacity (auto-hide). -->
        <Border x:Name="ControlsOverlay"
                VerticalAlignment="Bottom"
                Margin="10,12,12,12"
                Background="Transparent"
                IsHitTestVisible="True"
                Opacity="1"
                IsVisible="True">

            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Border.Transitions>

            <!-- Tres islas separadas horizontalmente -->
            <Grid ColumnSpacing="8" ColumnDefinitions="auto,*, auto">

                <!-- Isla 1: botones de reproducción -->
                <Border Classes="Island" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="icon" x:Name="PrevBtn" CornerRadius="15" ToolTip.Tip="Anterior (B)">
                            <Svg Path="Svgs/Preview.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                        </Button>
                        <Button Classes="icon" CornerRadius="15" x:Name="PlayPauseBtn" ToolTip.Tip="Play/Pausa (Space)">
                            <Grid HorizontalAlignment="Center">
                                <Svg x:Name="PlayIcon" Path="Svgs/Play.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                                <Svg x:Name="PauseIcon" Path="Svgs/Pause.svg" CurrentColor="{StaticResource AccentColor}" Width="20" IsVisible="False" />
                            </Grid>
                        </Button>
                        <Button Classes="icon" CornerRadius="15" x:Name="NextBtn" ToolTip.Tip="Siguiente (N)">
                            <Svg Path="Svgs/Next.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Isla 2: tiempos + seek bar -->
                <Border Classes="Island" Grid.Column="1">
                    <Grid ColumnDefinitions="auto,*,auto" Margin="3.5,0" ColumnSpacing="8">
                        <TextBlock x:Name="CurrentTimeText"
                                   Text="0:00"
                                   Padding="{StaticResource IslandComPadding}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="SeekBar"
                                Minimum="0" Grid.Column="1"
                                Maximum="1"
                                VerticalAlignment="Center"
                                SmallChange="1"
                                LargeChange="10" />
                        <TextBlock x:Name="DurationText"
                                   Padding="{StaticResource IslandComPadding}"
                                   Text="0:00" Grid.Column="2"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Isla 3: volumen + loop + audio -->
                <Border Classes="Island" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="icon" CornerRadius="15" x:Name="MuteBtn" ToolTip.Tip="Mute (M)">
                            <Grid HorizontalAlignment="Center">
                                <Svg x:Name="VolIcon" Path="Svgs/Volume.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                                <Svg x:Name="MuteIcon" Path="Svgs/VolumeMute.svg" CurrentColor="{StaticResource AccentColor}" Width="20" IsVisible="False" />
                            </Grid>
                        </Button>

                        <Button Classes="icon" x:Name="LoopBtn" CornerRadius="15" ToolTip.Tip="Loop (L)">
                            <Grid HorizontalAlignment="Center">
                                <Svg x:Name="LoopIcon" Path="Svgs/Loop.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                                <Svg x:Name="LoopOneIcon" Path="Svgs/LoopOne.svg" CurrentColor="{StaticResource AccentColor}" Width="20" IsVisible="False" />
                            </Grid>
                        </Button>

                        <Button Classes="icon" x:Name="AudioBtn" CornerRadius="15" ToolTip.Tip="Pista de audio (J)">
                            <Svg Path="Svgs/Sound.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

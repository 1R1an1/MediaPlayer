<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:MediaPlayer.Views"
             xmlns:skp="using:Avalonia.Svg"
             x:Class="MediaPlayer.Views.PlayerView" Background="Transparent">

    <Grid x:Name="RootGrid" Margin="2,0,0,0" Background="{StaticResource BackgroundBrush}">

        <!-- Video: renderiza via OpenGL a una textura Avalonia -->
        <v:MpvGlControl Margin="-2,0,0,0" IsVisible="False" x:Name="VideoHost" />

        <!-- Popup del slider de volumen. Va AFUERA del overlay para que no
        lo recorten los contenedores chicos. -->
        <Grid x:Name="VolumePopup"
              Margin="0,0,113.5,40"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              IsHitTestVisible="False"
              Opacity="0"
              Height="150"
              Background="Transparent">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Grid.Transitions>
            <Border
                Classes="Island"
                VerticalAlignment="Top"
                BorderThickness="1.5"
                Background="#da111111"
                BorderBrush="{StaticResource DividerBrush}"
                Height="120"
                Padding="5">
                <Slider x:Name="VolumeSlider"
                        Orientation="Vertical"
                        Foreground="#ccc"
                        Height="100"
                        Minimum="0"
                        Maximum="1"
                        Width="20" />
            </Border>
        </Grid>

        <!-- Overlay de video -->
        <Grid x:Name="OverlayGrid">
            <Grid ColumnDefinitions="0.75*,1.85*,7.40*" RowDefinitions="1*,1*,7*">
                <Viewbox x:Name="VolumeOverlay" Grid.Row="1" Grid.Column="1" Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" ClipToBounds="False">
                    <Viewbox.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </Viewbox.Transitions>

                    <StackPanel Orientation="Horizontal" ClipToBounds="False" MinWidth="40">
                        <TextBlock FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="25" Text="Volumen: ">
                            <TextBlock.Effect>
                                <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="16" Opacity="1" Color="#a000" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="VolumeTB" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="25" Text="100">
                            <TextBlock.Effect>
                                <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="16" Opacity="1" Color="#a000" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="25" Text="%">
                            <TextBlock.Effect>
                                <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="16" Opacity="1" Color="#a000" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Viewbox>
                <TextBlock x:Name="TitleVideo" Opacity="1" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" ClipToBounds="False"
                           VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="22.5" Margin="10,10,10,0" Text="" TextTrimming="CharacterEllipsis">
                    <TextBlock.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </TextBlock.Transitions>
                    <TextBlock.Effect>
                        <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="16" Opacity="1" Color="#a000" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
            <Grid ColumnDefinitions="3*,*,3*" RowDefinitions="3*,*,3*">
                <skp:Svg x:Name="OverlayIcon" Margin="0" CurrentColor="{StaticResource AccentColor}" Grid.Column="1" Grid.Row="1" Opacity="0">
                    <skp:Svg.Effect>
                        <DropShadowEffect OffsetX="4" OffsetY="4" BlurRadius="16" Opacity="1" Color="#a000" />
                    </skp:Svg.Effect>
                    <skp:Svg.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </skp:Svg.Transitions>
                </skp:Svg>
            </Grid>
        </Grid>

        <!-- Overlay que contiene las islas. Se oculta con Opacity (auto-hide). -->
        <!-- Barra única de controles -->
        <Border x:Name="ControlsOverlay"
                VerticalAlignment="Bottom"
                Margin="12,0,12,14"
                Classes="Island">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">

                <!-- Izquierda: Prev | Play/Pause | Next -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Classes="icon" x:Name="PrevBtn" ToolTip.Tip="Anterior (B)">
                        <skp:Svg Path="avares://MediaPlayer/Svgs/Preview.svg" CurrentColor="{StaticResource AccentColor}" Width="18"/>
                    </Button>
                    <Button Classes="icon" x:Name="PlayPauseBtn" ToolTip.Tip="Play/Pausa (Space)">
                        <Grid HorizontalAlignment="Center">
                            <skp:Svg x:Name="PlayIcon" Path="avares://MediaPlayer/Svgs/Play.svg" CurrentColor="{StaticResource AccentColor}" Width="20"/>
                            <skp:Svg x:Name="PauseIcon" Path="avares://MediaPlayer/Svgs/Pause.svg" CurrentColor="{StaticResource AccentColor}" Width="20" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Classes="icon" x:Name="NextBtn" ToolTip.Tip="Siguiente (N)">
                        <skp:Svg Path="avares://MediaPlayer/Svgs/Next.svg" CurrentColor="{StaticResource AccentColor}" Width="18"/>
                    </Button>
                </StackPanel>

                <!-- Centro: tiempos + seek -->
                <Grid Grid.Column="1" ColumnDefinitions="auto,*,auto" ColumnSpacing="7.5">
                    <TextBlock x:Name="CurrentTimeText" Text="0:00"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            SmallChange="1" LargeChange="10"/>
                    <TextBlock x:Name="DurationText" Text="0:00" Grid.Column="2"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Derecha: mute | loop | audio | fullscreen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="icon" x:Name="MuteBtn" ToolTip.Tip="Mute (M)">
                        <Grid HorizontalAlignment="Center">
                            <skp:Svg x:Name="VolIcon" Path="avares://MediaPlayer/Svgs/Volume.svg" CurrentColor="{StaticResource AccentColor}" Width="19.5"/>
                            <skp:Svg x:Name="MuteIcon" Path="avares://MediaPlayer/Svgs/VolumeMute.svg" CurrentColor="{StaticResource MutedColor}" Width="19.5" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Classes="icon" x:Name="LoopBtn" ToolTip.Tip="Loop (L)">
                        <Grid HorizontalAlignment="Center">
                            <skp:Svg x:Name="LoopIcon" Path="avares://MediaPlayer/Svgs/Loop.svg" CurrentColor="{StaticResource MutedColor}" Width="19.5"/>
                            <skp:Svg x:Name="LoopOneIcon" Path="avares://MediaPlayer/Svgs/LoopOne.svg" CurrentColor="{StaticResource AccentColor}" Width="19.5" IsVisible="False"/>
                        </Grid>
                    </Button>
                    <Button Classes="icon" x:Name="AudioBtn" ToolTip.Tip="Pista de audio (J)">
                        <skp:Svg Path="avares://MediaPlayer/Svgs/Sound.svg" CurrentColor="{StaticResource AccentColor}" Width="19.5"/>
                    </Button>
                    <Button Classes="icon" x:Name="FullScreenBtn" ToolTip.Tip="Pantalla completa (F)">
                        <Grid HorizontalAlignment="Center">
                            <skp:Svg x:Name="FullScreenIcon" Path="avares://MediaPlayer/Svgs/Fullscreen.svg" CurrentColor="{StaticResource AccentColor}" Width="18"/>
                            <skp:Svg x:Name="NoFullScreenIcon" Path="avares://MediaPlayer/Svgs/NoFullscreen.svg" CurrentColor="{StaticResource AccentColor}" Width="19.5" IsVisible="False"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

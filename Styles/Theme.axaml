<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta: tema negro con accent blanco -->
    <Color x:Key="BackgroundColor">#0a0a0a</Color>
    <Color x:Key="ForegroundColor">#fff</Color>
    <Color x:Key="MutedColor">#888</Color>
    <Color x:Key="BorderColor">#8777</Color>
    <Color x:Key="AccentColor">#fff</Color>

    <!-- Isla flotante: fondo semi-transparente -->
    <Color x:Key="IslandColor">#a000</Color>

    <!-- Estados de botones (blanco semi-transparente sobre fondo negro) -->
    <Color x:Key="HoverColor">#2fff</Color>
    <Color x:Key="PressedColor">#3fff</Color>
    <Color x:Key="DisabledColor">#5fff</Color>

    <!-- Slider: track vacío (blanco 20%) -->
    <Color x:Key="TrackEmptyColor">#3fff</Color>
    <Color x:Key="TrackEmptyDisabledColor">#2fff</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush"         Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush"         Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush"              Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush"             Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="IslandBrush"             Color="{StaticResource IslandColor}" />

    <SolidColorBrush x:Key="HoverBrush"              Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush"            Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush"           Color="{StaticResource DisabledColor}" />

    <SolidColorBrush x:Key="TrackEmptyBrush"         Color="{StaticResource TrackEmptyColor}" />
    <SolidColorBrush x:Key="TrackEmptyDisabledBrush" Color="{StaticResource TrackEmptyDisabledColor}" />

    <!-- <SolidColorBrush x:Key="SeparatorBrush"       Color="{StaticResource SeparatorColor}" /> -->

    <!-- Tipografía -->
    <FontFamily x:Key="DefaultFontFamily">Inter, SF Pro Display, Segoe UI, Noto Sans, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">JetBrains Mono, SF Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <x:Double x:Key="FontSizeSmall">13.5</x:Double>
    <x:Double x:Key="FontSizeNormal">14</x:Double>
    <x:Double x:Key="FontSizeMedium">16</x:Double>

    <!-- Otros -->
    <CornerRadius x:Key="IslandCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">16</CornerRadius>
    <Thickness x:Key="AllBorderThickness">2</Thickness>
    <Thickness x:Key="IslandComPadding">4</Thickness>

    <!-- Sombra de las islas -->
    <BoxShadows x:Key="ControlShadow">0 4 16 0 #a000</BoxShadows>
</ResourceDictionary>

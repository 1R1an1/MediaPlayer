<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / UserControl -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <!-- Button base -->
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.texticon">
        <Setter Property="Padding" Value="8,4,8,0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.texticon.bold">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="{StaticResource IslandComPadding}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="Border.Island">
        <Setter Property="Padding" Value="{StaticResource IslandComPadding}" />
        <Setter Property="Background" Value="{StaticResource IslandBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource IslandCornerRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllBorderThickness}" />
        <Setter Property="BoxShadow" Value="{StaticResource ControlShadow}" />
    </Style>

    <!-- Slider -->
    <Style Selector="Slider">
        <Setter Property="Background" Value="{StaticResource TrackEmptyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="CornerRadius" Value="3" />
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackValueFill"              Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver"   Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed"       Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled"      Color="{StaticResource DisabledColor}" />

            <SolidColorBrush x:Key="SliderTrackFill"                   Color="{StaticResource TrackEmptyColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver"        Color="{StaticResource TrackEmptyColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPressed"            Color="{StaticResource TrackEmptyColor}" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled"           Color="{StaticResource TrackEmptyDisabledColor}" />

            <SolidColorBrush x:Key="SliderThumbBackground"             Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver"  Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed"      Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled"     Color="{StaticResource DisabledColor}" />

            <SolidColorBrush x:Key="SliderContainerBackground"             Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver"  Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed"      Color="Transparent" />

            <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
            <x:Double x:Key="SliderVerticalThumbWidth">12</x:Double>
            <x:Double x:Key="SliderVerticalThumbHeight">12</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
        </Style.Resources>
    </Style>

    <Style Selector="Slider /template/ Track">
        <Setter Property="Height" Value="3" />
    </Style>

    <Style Selector="Slider:vertical /template/ Track">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="100" />
    </Style>

    <!-- ScrollBar fina -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="6" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="1" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    </Style>

    <!-- ContextMenu -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{StaticResource IslandBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllBorderThickness}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>

    <!-- ToggleButton -->
    <Style Selector="ToggleButton.anim-switch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Track"
                        Width="39"
                        Height="18"
                        CornerRadius="11"
                        Padding="3">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.25" />
                        </Transitions>
                    </Border.Transitions>

                    <Border x:Name="PART_Thumb"
                            Width="15"
                            Height="12"
                            CornerRadius="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            RenderTransform="translate(0px,0px)">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform"
                                                               Duration="0:0:0.25"
                                                               Easing="CubicEaseOut" />
                                <BrushTransition Property="Background" Duration="0:0:0.25" />
                            </Transitions>
                        </Border.Transitions>

                        <Grid>
                            <Path x:Name="PART_PlayIcon"
                                  Width="6"
                                  Height="6"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 6,3 L 0,6 Z">
                                <Path.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                        <BrushTransition Property="Fill" Duration="0:0:0.25" />
                                    </Transitions>
                                </Path.Transitions>
                            </Path>

                            <Path x:Name="PART_PauseIcon"
                                  Width="6"
                                  Height="6"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 H 2 V 6 H 0 Z M 4,0 H 6 V 6 H 4 Z">
                                <Path.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                        <BrushTransition Property="Fill" Duration="0:0:0.25" />
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Estado desactivado -->
    <Style Selector="ToggleButton.anim-switch /template/ Border#PART_Track">
        <Setter Property="Background" Value="#88424242" />
    </Style>
    <Style Selector="ToggleButton.anim-switch /template/ Border#PART_Thumb">
        <Setter Property="Background" Value="#dfff" />
    </Style>
    <Style Selector="ToggleButton.anim-switch /template/ Path#PART_PlayIcon">
        <Setter Property="Fill" Value="#424242" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.anim-switch /template/ Path#PART_PauseIcon">
        <Setter Property="Fill" Value="#ddd" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Estado activado -->
    <Style Selector="ToggleButton.anim-switch:checked /template/ Border#PART_Track">
        <Setter Property="Background" Value="#cfff" />
    </Style>
    <Style Selector="ToggleButton.anim-switch:checked /template/ Border#PART_Thumb">
        <Setter Property="RenderTransform" Value="translate(18px,0px)" />
        <Setter Property="Background" Value="#424242" />
    </Style>
    <Style Selector="ToggleButton.anim-switch:checked /template/ Path#PART_PlayIcon">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ToggleButton.anim-switch:checked /template/ Path#PART_PauseIcon">
        <Setter Property="Opacity" Value="1" />
    </Style>
</Styles>

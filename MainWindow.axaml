<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MediaPlayer.Views"
        x:Class="MediaPlayer.MainWindow"
        Title="MediaPlayer"
        Width="854" Height="480"
        MinWidth="426" MinHeight="240"
        WindowState="Normal">

    <Grid x:Name="RootGrid" ColumnDefinitions="*,auto">

        <!-- Player (video + overlay) -->
        <v:PlayerView Grid.Column="0" x:Name="PlayerControl" />

        <!-- Playlist lateral -->
        <Grid Grid.Column="1" ColumnDefinitions="3,*" x:Name="PlaylistGrid" IsVisible="False" >
            <Border Width="3" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Cursor="SizeWestEast" PointerPressed="Border_PointerPressed" PointerMoved="Border_PointerMoved" PointerReleased="Border_PointerReleased"/>
            <v:PlaylistView Grid.Column="1" x:Name="Playlist"/>
        </Grid>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MediaPlayer.Views"
        x:Class="MediaPlayer.MainWindow"
        Title="MediaPlayer"
        Width="1100" Height="680"
        MinWidth="640" MinHeight="400"
        WindowState="Normal"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

    <Grid x:Name="RootGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />   <!-- Playlist panel, colapsable -->
        </Grid.ColumnDefinitions>

        <!-- Player (video + overlay) -->
        <v:PlayerView Grid.Column="0" x:Name="PlayerControl" />

        <!-- Playlist lateral -->
        <v:PlaylistView Grid.Column="1" x:Name="Playlist"
                        IsVisible="False" />

    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:MediaPlayer.Views"
        x:Class="MediaPlayer.MainWindow"
        Title="MediaPlayer"
        Width="854" Height="480"
        MinWidth="640" MinHeight="360"
        WindowState="Normal">

    <Grid x:Name="RootGrid">

        <!-- Player (video + overlay) -->
        <v:PlayerView Grid.Column="0" x:Name="PlayerView" />

        <!-- Playlist lateral -->
        <Grid x:Name="PlaylistGrid" Background="#a000"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
              Opacity="0" IsVisible="False" ColumnDefinitions="*,5*,*" RowDefinitions="*,5*,*">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Grid.Transitions>

            <Border BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BackgroundBrush}" BorderThickness="{StaticResource AllBorderThickness}"
                    Grid.Row="1" Grid.Column="1" CornerRadius="15" BoxShadow="0 8 32 0 #8000">
                <v:PlaylistView CornerRadius="17" x:Name="PlaylistView"/>
            </Border>
        </Grid>
    </Grid>
</Window>
